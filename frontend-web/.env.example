# Vite frontend env template
# Copy thành .env và sửa nếu cần (file .env đã trong .gitignore, không commit).
#
# DEV: để "/api" — vite.config.js đã setup proxy /api → http://localhost:5000
# PROD: docker-compose.prod.yml truyền qua build arg, KHÔNG đọc file này
VITE_API_URL=/api

# Sentry browser error tracking (optional) — để rỗng nếu chưa setup
# Lấy: https://sentry.io → Create Project (React) → Copy DSN
VITE_SENTRY_DSN=
