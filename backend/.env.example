NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/road_freight

# Redis cache + distributed rate-limit. Bỏ trống → không cache (vẫn chạy, chậm 4-5×).
# Khi chạy `make start` Docker compose tự khởi Redis container ở port 6379.
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
REFRESH_JWT_SECRET=change-me-too-different-from-above
REFRESH_JWT_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads

# Sentry error tracking (optional). Bỏ trống → backend không gửi event.
# Lấy DSN: https://sentry.io → Create Project (Node.js) → Client Keys
SENTRY_DSN=

# SMTP (optional). Bỏ trống → email log ra console + ghi file ./tmp/emails/
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Road Freight TMS <no-reply@road-freight.io>

# Gemini AI (optional). Bỏ trống → chatbot fallback về keyword matching.
# Lấy API key miễn phí tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
