# ============================================================
# Backend production environment — template
# Copy thành .env.production trên server và điền giá trị thật.
# KHÔNG bao giờ commit .env.production lên git!
# ============================================================

# --- Core ---
NODE_ENV=production
PORT=5000

# --- Database ---
# Dùng MongoDB nội bộ trong docker-compose.prod.yml (mặc định):
MONGODB_URI=mongodb://mongo:27017/road_freight
# Hoặc dùng MongoDB Atlas (khuyến nghị khi lên prod thật):
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/road_freight

# --- Auth ---
# Sinh ngẫu nhiên 256-bit:  openssl rand -hex 32
JWT_SECRET=REPLACE_ME_WITH_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# --- URL ---
# URL public của frontend web (dùng cho CORS + link trong email gửi cho khách).
# Vd: http://47.129.225.75:8080 (IP EC2)  hoặc  https://tms.your-domain.com (sau khi có domain).
FRONTEND_URL=http://YOUR-EC2-IP:8080

# --- Upload ---
UPLOAD_DIR=uploads

# --- Optimizer ---
OPTIMIZER_SERVICE_URL=http://optimizer:8000
OPTIMIZER_TIMEOUT_MS=60000

# --- SMTP (gửi email xác thực / quên mật khẩu / thông báo) ---
#
# QUAN TRỌNG: SMTP_USER là EMAIL HỆ THỐNG dùng để GỬI mail.
# KHÔNG phải email của khách đăng ký (khách là người nhận).
#
# Cách lấy App Password Gmail:
#   1. Login vào tài khoản Gmail hệ thống (vd: company-noreply@gmail.com)
#   2. Vào https://myaccount.google.com/apppasswords
#   3. Tạo App Password mới → copy 16 ký tự (chỉ hiện 1 lần)
#   4. Dán vào SMTP_PASS bên dưới
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=system-sender@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=Road Freight TMS <system-sender@gmail.com>
SUPPORT_EMAIL=system-sender@gmail.com

# --- AI Assistant (Gemini) ---
# Lấy key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# --- IMAP (backend đọc email vào hộp thư hệ thống) ---
# Dùng cùng tài khoản Gmail với SMTP, NHƯNG App Password phải tạo riêng cho IMAP
# (Google không cho dùng chung 1 App Password cho cả SMTP và IMAP).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=system-sender@gmail.com
IMAP_PASS=xxxx-xxxx-xxxx-xxxx
IMAP_POLL_INTERVAL_MS=30000
