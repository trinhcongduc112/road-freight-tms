# Mobile app env — COPY thành .env.local rồi sửa giá trị.
# Mọi biến cho client phải có prefix EXPO_PUBLIC_ để Expo bundle vào app.

# URL backend mà app gọi. Mặc định để trống → app sẽ auto-detect:
#   - Expo Go: dùng IP của Metro bundler
#   - Emulator: 10.0.2.2 (Android) / localhost (iOS)
#
# Khi build APK release: set hẳn URL EC2/domain ở đây hoặc trong eas.json (mục build.<profile>.env)
# VD test thử trên Expo Go nhưng trỏ vào server thật:
#   EXPO_PUBLIC_API_URL=http://47.129.225.75:8080/api
EXPO_PUBLIC_API_URL=
