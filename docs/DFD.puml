rectangle "Customer\n(ePOD email — KH)"    as CUST    <<external>>
rectangle "Gemini API"                     as GEM     <<external>>
rectangle "SMTP Email"                     as SMTP    <<external>>
rectangle "Process 4.0\nRoute Planning"    as P5EXT   <<external>>
rectangle "Process 3.0\nSales Order"        as P4EXT   <<external>>
rectangle "Process 7.0\nPayroll"            as P8EXT   <<external>>

usecase "5.1\nConfirm Trip\n(Nhận chuyến)"               as P61  <<process>>
usecase "5.2\nLoading\n(Soạn hàng)"                       as P62  <<process>>
usecase "5.3\nStart Trip\n(Bắt đầu chuyến)"               as P63  <<process>>
